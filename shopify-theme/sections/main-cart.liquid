{% comment %}
  DEXYFIED Main Cart Section
  Dedicated /cart page with flat shipping calculation and Cash on Delivery reassurance
{% endcomment %}

<div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;">
  <div class="dexy-container" style="max-width: 54rem;">
    <div style="padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-main); margin-bottom: 2rem;">
      <h1 style="font-family: var(--font-display); font-weight: 700; font-size: 2rem; text-transform: uppercase; color: var(--text-primary); margin: 0;">
        Shopping Bag [{{ cart.item_count }}]
      </h1>
      <p style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; margin-top: 0.25rem;">
        LOGISTICS STATUS: FLAT PKR 150 NATIONWIDE • CASH ON DELIVERY AVAILABLE
      </p>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cartForm">
        <div style="border: 1px solid var(--border-main); border-radius: var(--radius-xs); overflow: hidden; background: var(--bg-surface);">
          {% for item in cart.items %}
            <div style="display: flex; gap: 1.25rem; padding: 1.5rem; border-bottom: 1px solid var(--border-main); align-items: center;" class="cart-line-item">
              <div style="width: 5.5rem; height: 5.5rem; background: var(--bg-surface-elevated); border: 1px solid var(--border-main); border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; padding: 0.5rem; flex-shrink: 0;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                {% endif %}
              </div>

              <div style="flex: 1;">
                <h3 style="font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--text-primary); margin: 0;">
                  <a href="{{ item.url }}" style="color: inherit;">{{ item.product.title }}</a>
                </h3>

                {% if item.variant.title != blank and item.variant.title != 'Default Title' %}
                  <div style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-top: 0.25rem;">
                    OPTION: {{ item.variant.title }}
                  </div>
                {% endif %}

                {% for property in item.properties %}
                  {% unless property.first.first == '_' %}
                    <div style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700; margin-top: 0.25rem;">
                      {{ property.first }}: {{ property.last }}
                    </div>
                  {% endunless %}
                {% endfor %}

                <div style="font-family: var(--font-tech); font-size: 0.8125rem; color: var(--text-dim); margin-top: 0.5rem;">
                  {{ item.final_price | money_without_trailing_zeros }} each
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 1.5rem;">
                <!-- Quantity Input -->
                <div style="display: flex; align-items: center; border: 1px solid var(--border-main); border-radius: var(--radius-xs); background: var(--bg-surface-elevated);">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    style="width: 3.5rem; text-align: center; border: none; background: transparent; padding: 0.5rem; font-family: var(--font-tech); font-weight: 700; font-size: 0.875rem;"
                  >
                </div>

                <div style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--text-primary); min-width: 6rem; text-align: right;">
                  {{ item.final_line_price | money_without_trailing_zeros }}
                </div>

                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="color: var(--text-dim); padding: 0.5rem;" title="Remove">
                  ✕
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Cart Summary Box -->
        <div style="margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--border-main); background: var(--bg-surface-elevated); border-radius: var(--radius-xs); display: flex; flex-direction: column; gap: 0.75rem; max-width: 24rem; margin-left: auto;">
          <div style="display: flex; justify-content: space-between; font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-muted);">
            <span>SUBTOTAL</span>
            <span style="font-weight: 700; color: var(--text-primary);">{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>

          <div style="display: flex; justify-content: space-between; font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-muted);">
            <span>SHIPPING (PAKISTAN)</span>
            <span style="font-weight: 700; color: var(--text-primary);">PKR 150</span>
          </div>

          <div style="padding-top: 0.75rem; border-top: 1px solid var(--border-main); display: flex; justify-content: space-between; align-items: baseline;">
            <div>
              <span style="font-family: var(--font-display); font-weight: 700; font-size: 0.875rem; text-transform: uppercase;">TOTAL DUE</span>
              <p style="font-family: var(--font-tech); font-size: 0.625rem; color: var(--success-color); font-weight: 700; margin-top: 2px;">
                ✓ CASH ON DELIVERY AVAILABLE
              </p>
            </div>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--text-primary);">
              {{ cart.total_price | plus: 15000 | money_without_trailing_zeros }}
            </span>
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
            <button type="submit" name="update" class="btn-secondary" style="flex: 1; padding: 0.75rem; font-size: 0.75rem;">
              UPDATE
            </button>
            <button type="submit" name="checkout" class="btn-primary" style="flex: 2; padding: 0.75rem; font-size: 0.75rem;">
              CHECKOUT →
            </button>
          </div>
        </div>
      </form>
    {% else %}
      <div style="text-align: center; padding: 5rem 1rem;">
        <p style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; text-transform: uppercase;">
          Your shopping cart is currently empty
        </p>
        <p style="font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); margin-top: 0.5rem;">
          Explore our catalog of verified consumer tech hardware.
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="margin-top: 1.5rem;">
          EXPLORE CATALOG
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}

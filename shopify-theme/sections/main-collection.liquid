{% comment %}
  DEXYFIED Main Collection Catalog Section
  Faithful reproduction of React CatalogPage.tsx:
  Interactive category filter pills, price range slider, sort selector, dynamic count, and responsive grid
{% endcomment %}

{%- liquid
  assign products_list = collection.products
  if products_list.size == 0 and collections['all'].products.size > 0
    assign products_list = collections['all'].products
  endif
-%}

<div style="background-color: var(--bg-surface); padding-top: 2.5rem; padding-bottom: 6rem;" data-catalog-section>
  <div class="dexy-container">
    <!-- Header -->
    <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-main); margin-bottom: 2rem;" class="reveal-on-scroll">
      <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; font-weight: 700;">
        <span class="status-dot status-dot-blue"></span>
        <span>STOREFRONT HARDWARE DIRECTORY</span>
      </div>
      <div class="catalog-header-flex">
        <div>
          <h1 style="font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; text-transform: uppercase; color: var(--text-primary); margin: 0; line-height: 1.15;">
            {{ collection.title | default: 'Product Catalog' }}
          </h1>
          <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem; max-width: 36rem;">
            Browse all physical consumer technology products available for immediate nationwide dispatch.
          </p>
        </div>

        <div style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">
          SHOWING <span data-filtered-count>{{ products_list.size }}</span> OF {{ products_list.size }} ITEMS
        </div>
      </div>
    </div>

    <!-- Filter & Sort Controls Bar -->
    <div class="catalog-controls-bar reveal-on-scroll">
      <!-- Category Filter Pills -->
      <div class="catalog-category-pills">
        <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; display: flex; align-items: center; gap: 0.375rem; font-weight: 700; flex-shrink: 0;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          FILTER:
        </span>

        <button type="button" class="catalog-pill active" data-cat-filter="all">All</button>
        <button type="button" class="catalog-pill" data-cat-filter="workspace">Workspace</button>
        <button type="button" class="catalog-pill" data-cat-filter="audio">Audio</button>
        <button type="button" class="catalog-pill" data-cat-filter="smart watches">Smart Watches</button>
        <button type="button" class="catalog-pill" data-cat-filter="wearables">Wearables</button>
      </div>

      <!-- Sort & Price Filter Row -->
      <div class="catalog-sort-price-wrap">
        <!-- Price Range Slider -->
        <div class="price-slider-wrap">
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase;">MAX:</span>
          <span style="font-family: var(--font-tech); font-size: 0.75rem; font-weight: 700; color: var(--text-primary);">
            PKR <span data-max-price-display>5,000</span>
          </span>
          <input
            type="range"
            min="550"
            max="5000"
            step="50"
            value="5000"
            data-price-slider
            aria-label="Filter products by maximum price"
            style="width: 5.5rem; accent-color: var(--text-primary); cursor: pointer;"
          >
        </div>

        <!-- Sort Selector -->
        <div class="sort-selector-wrap">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-dim);">
            <path d="m3 16 4 4 4-4"></path>
            <path d="M7 20V4"></path>
            <path d="m21 8-4-4-4 4"></path>
            <path d="M17 4v16"></path>
          </svg>
          <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase;">SORT:</span>
          <select data-sort-select aria-label="Sort products">
            <option value="default">Item Number</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="catalog-grid" data-catalog-grid>
      {% for product in products_list %}
        {% render 'product-card', product: product %}
      {% else %}
        <div class="catalog-empty-state" style="display: block;">
          <p style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;">
            NO PRODUCTS AVAILABLE IN STORE CATALOG.
          </p>
        </div>
      {% endfor %}
    </div>

    <!-- Empty Filtered Results State -->
    <div class="catalog-empty-state" data-empty-filter-state style="display: none;">
      <p style="font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 1rem 0;">
        NO HARDWARE MATCHES THE SELECTED FILTERS.
      </p>
      <button type="button" class="btn-tech" data-reset-filters style="font-size: 0.6875rem; padding: 0.5rem 1rem;">
        RESET FILTERS
      </button>
    </div>
  </div>
</div>

<style>
  .catalog-header-flex {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .catalog-header-flex {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  .catalog-controls-bar {
    padding: 1rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 1024px) {
    .catalog-controls-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .catalog-category-pills {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .catalog-category-pills::-webkit-scrollbar {
    display: none;
  }
  .catalog-pill {
    padding: 0.375rem 0.75rem;
    font-family: var(--font-tech);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    color: var(--text-muted);
    border-radius: var(--radius-xs);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .catalog-pill:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }
  .catalog-pill.active {
    background-color: var(--accent-blue);
    border-color: var(--accent-blue);
    color: #FFFFFF;
    font-weight: 700;
  }
  .catalog-sort-price-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-main);
  }
  @media (min-width: 1024px) {
    .catalog-sort-price-wrap {
      padding-top: 0;
      border-top: none;
    }
  }
  .price-slider-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sort-selector-wrap {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    border-radius: var(--radius-xs);
  }
  .sort-selector-wrap select {
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-tech);
    font-size: 0.75rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .catalog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }
  @media (min-width: 1280px) {
    .catalog-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .catalog-empty-state {
    padding: 4rem 1rem;
    text-align: center;
    border: 1px dashed var(--border-bright);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    grid-column: 1 / -1;
  }
</style>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}

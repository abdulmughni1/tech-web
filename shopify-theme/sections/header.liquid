<header class="header-main">
  <div class="dexy-container">
    <div class="header-inner">
      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" style="display: inline-flex; align-items: center; gap: 0.625rem; text-decoration: none;">
        <div style="background-color: #09090B; padding: 2px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; overflow: hidden;">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: height: 36 }}" alt="{{ shop.name }}" style="height: 2.25rem; width: auto; object-fit: contain;">
          {% else %}
            <img src="{{ 'dexyfied-logo-raw.jpg' | asset_url }}" alt="DEXYFIED Mark" style="height: 2.25rem; width: auto; object-fit: contain; mix-blend-mode: screen; filter: contrast(1.25) brightness(1.1);">
          {% endif %}
        </div>
        <div style="display: flex; flex-direction: column; justify-content: center; line-height: 1;">
          <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-primary);">
            {{ shop.name | default: 'DEXYFIED' }}
          </span>
          <span style="font-family: var(--font-tech); font-size: 0.625rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-dim); margin-top: 2px;">
            HARDWARE // PAKISTAN
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="nav-links" style="display: none;">
        {% for link in linklists[section.settings.menu].links %}
          <a
            href="{{ link.url }}"
            class="nav-link {% if link.active %}active{% endif %}"
          >
            {{ link.title }}
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="nav-link active">Home</a>
          <a href="{{ routes.all_products_collection_url }}" class="nav-link">Shop</a>
          <a href="/pages/about" class="nav-link">About</a>
          <a href="/pages/contact" class="nav-link">Contact</a>
        {% endfor %}
      </nav>

      <!-- Desktop Navigation Responsive Display CSS -->
      <style>
        @media (min-width: 768px) {
          .nav-links { display: flex !important; }
        }
      </style>

      <!-- Actions (Theme Toggle + Search + Cart + Mobile Hamburger) -->
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <!-- Dark/Light Mode Switcher -->
        <button
          type="button"
          data-theme-toggle
          class="btn-tech"
          style="padding: 0.5rem; border-color: var(--border-main);"
          aria-label="Toggle theme mode"
          title="Toggle dark/light theme"
        >
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <!-- Search Trigger -->
        <button
          type="button"
          data-search-trigger
          class="btn-tech"
          style="padding: 0.5rem; border-color: var(--border-main);"
          aria-label="Search catalog"
          title="Search products"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Cart Bag Trigger -->
        <button
          type="button"
          data-cart-open
          class="btn-tech"
          style="padding: 0.5rem 0.75rem; border-color: var(--border-main); display: flex; align-items: center; gap: 0.375rem; background: var(--bg-surface); position: relative;"
          aria-label="Open cart bag"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span style="font-family: var(--font-tech); font-weight: 700; font-size: 0.75rem;">
            [<span data-cart-count>{{ cart.item_count }}</span>]
          </span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          data-mobile-menu-toggle
          class="btn-tech md-hidden"
          style="padding: 0.5rem;"
          aria-label="Toggle navigation menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div
    data-mobile-menu
    class="hidden"
    style="display: none; border-top: 1px solid var(--border-main); background: var(--bg-surface); padding: 1.5rem 1rem; box-shadow: var(--shadow-md);"
  >
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      {% for link in linklists[section.settings.menu].links %}
        <a
          href="{{ link.url }}"
          style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.5rem 0.75rem; border-radius: var(--radius-xs); color: {% if link.active %}var(--accent-blue){% else %}var(--text-primary){% endif %}; font-weight: {% if link.active %}700{% else %}500{% endif %}; background: {% if link.active %}var(--bg-surface-elevated){% else %}transparent{% endif %};"
        >
          {{ link.title }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.5rem;">Home</a>
        <a href="{{ routes.all_products_collection_url }}" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.5rem;">Shop</a>
        <a href="/pages/about" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.5rem;">About</a>
        <a href="/pages/contact" style="font-family: var(--font-display); font-size: 0.875rem; text-transform: uppercase; padding: 0.5rem;">Contact</a>
      {% endfor %}
    </div>

    <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-main); font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); display: flex; flex-direction: column; gap: 0.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span>THEME MODE:</span>
        <button type="button" data-theme-toggle class="btn-tech" style="padding: 0.25rem 0.5rem; font-size: 0.6875rem;">
          SWITCH THEME
        </button>
      </div>
      <div>SUPPORT: +92 319 4389617</div>
      <div>FLAT PKR 150 SHIPPING NATIONWIDE</div>
    </div>
  </div>
</header>

<style>
  @media (min-width: 768px) {
    .md-hidden { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

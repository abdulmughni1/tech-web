{%- if section.settings.show_announcement -%}
  <div class="announcement-bar">
    <div class="announcement-content">
      <span class="announcement-primary">{{ section.settings.text_1 | default: 'NATIONWIDE DELIVERY PKR 150' }}</span>
      <span class="announcement-separator">•</span>
      <span class="announcement-secondary">{{ section.settings.text_2 | default: '7-DAY RETURN POLICY' }}</span>
      <span class="announcement-separator announcement-phone-item">•</span>
      <span class="announcement-phone-item">SUPPORT: {{ section.settings.support_phone | default: '+92 319 4389617' }}</span>
    </div>
  </div>

  <style>
    .announcement-content {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      line-height: 1.4;
    }
    .announcement-primary {
      font-weight: 600;
      color: var(--text-primary);
    }
    .announcement-separator {
      color: var(--border-bright);
    }
    .announcement-phone-item {
      display: none;
    }
    @media (min-width: 640px) {
      .announcement-content {
        gap: 0.75rem;
      }
      .announcement-phone-item {
        display: inline;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement banner",
      "default": true
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Primary announcement",
      "default": "NATIONWIDE DELIVERY PKR 150"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Secondary note",
      "default": "7-DAY RETURN POLICY"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support contact",
      "default": "+92 319 4389617"
    }
  ]
}
{% endschema %}

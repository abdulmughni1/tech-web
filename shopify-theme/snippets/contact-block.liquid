{% comment %}
  DEXYFIED Contact Block Snippet
  Shared between sections/main-contact.liquid and fallback pages
{% endcomment %}

<div class="dexy-container" style="max-width: 64rem;">
  <!-- Page Header -->
  <div style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-main); margin-bottom: 3rem;" class="reveal-on-scroll">
    <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; font-weight: 700;">
      <span class="status-dot status-dot-blue"></span>
      <span>CUSTOMER SUPPORT &amp; DISPATCH INQUIRIES</span>
    </div>
    <h1 style="font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; text-transform: uppercase; color: var(--text-primary); margin: 0; line-height: 1.15;">
      Contact DEXYFIED
    </h1>
    <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.5rem; max-width: 38rem;">
      Reach our customer service desk for order assistance, return requests, or technical inquiries.
    </p>
  </div>

  <div class="contact-grid">
    <!-- Left Column: Direct Contact Channels -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <!-- Phone & WhatsApp Card -->
      <div class="contact-card reveal-on-scroll">
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>DIRECT PHONE &amp; WHATSAPP</span>
        </div>
        <div style="font-family: var(--font-tech); font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-top: 0.5rem;">
          +92 319 4389617
        </div>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.5; margin-top: 0.25rem;">
          Direct phone inquiries and instant WhatsApp ordering available nationwide across Pakistan.
        </p>
        <div style="margin-top: 0.875rem;">
          <a
            href="https://wa.me/923194389617"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-whatsapp-btn"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>START WHATSAPP CHAT</span>
          </a>
        </div>
      </div>

      <!-- Official Inbox Card -->
      <div class="contact-card reveal-on-scroll">
        <div style="display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>OFFICIAL INBOX</span>
        </div>
        <div style="font-family: var(--font-tech); font-size: 1rem; font-weight: 700; color: var(--text-primary); margin-top: 0.5rem;">
          <a href="mailto:dexyfied@gmail.com" style="color: inherit;">dexyfied@gmail.com</a>
        </div>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); line-height: 1.5; margin-top: 0.25rem;">
          Send return notifications, receipt verifications, or commercial inquiries. Monitored daily.
        </p>
      </div>

      <!-- Official Social Pages Card -->
      <div class="contact-card reveal-on-scroll">
        <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; display: block; font-weight: 700; margin-bottom: 0.75rem;">
          OFFICIAL SOCIAL PAGES
        </span>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <a
            href="https://www.instagram.com/dexyfied_store/"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-social-link"
          >
            <span>INSTAGRAM / @dexyfied_store</span>
            <span>→</span>
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=61588688573200"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-social-link"
          >
            <span>FACEBOOK PAGE</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Shopify Native Inquiry Form -->
    <div class="reveal-on-scroll">
      <div class="contact-form-card">
        <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 0.25rem 0;">
          Send A Direct Message
        </h2>
        <p style="font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); margin: 0 0 1.5rem 0;">
          Fill in your details and our team will get in touch with you promptly.
        </p>

        {% form 'contact', id: 'ContactForm' %}
          {% if form.posted_successfully? %}
            <div class="contact-success-banner">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--success-color); margin-bottom: 0.5rem;">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 0.25rem 0;">
                Message Transmitted
              </h3>
              <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); max-width: 24rem; margin: 0 auto; line-height: 1.5;">
                Thank you. We have received your inquiry and will contact you at your provided email or phone promptly.
              </p>
            </div>
          {% else %}
            {% if form.errors %}
              <div class="contact-error-banner">
                <span style="font-family: var(--font-tech); font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">
                  Please correct the following errors:
                </span>
                <ul style="margin: 0.5rem 0 0 1rem; padding: 0; font-size: 0.75rem;">
                  {% for error in form.errors %}
                    <li>{{ form.errors.messages[error] }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="form-grid-2">
              <div>
                <label for="ContactFormName" class="form-label">
                  Your Name *
                </label>
                <input
                  type="text"
                  name="contact[name]"
                  id="ContactFormName"
                  required
                  placeholder="e.g. Tariq Ahmed"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  class="form-input"
                >
              </div>

              <div>
                <label for="ContactFormPhone" class="form-label">
                  Phone Number *
                </label>
                <input
                  type="tel"
                  name="contact[phone]"
                  id="ContactFormPhone"
                  required
                  placeholder="0300 1234567"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  class="form-input font-tech"
                >
              </div>
            </div>

            <div style="margin-top: 1rem;">
              <label for="ContactFormEmail" class="form-label">
                Email Address *
              </label>
              <input
                type="email"
                name="contact[email]"
                id="ContactFormEmail"
                required
                placeholder="name@example.com"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                class="form-input font-tech"
              >
            </div>

            <div style="margin-top: 1rem;">
              <label for="ContactFormSubject" class="form-label">
                Subject *
              </label>
              <input
                type="text"
                name="contact[subject]"
                id="ContactFormSubject"
                required
                placeholder="Order Inquiry / Product Question / Return Request"
                class="form-input"
              >
            </div>

            <div style="margin-top: 1rem;">
              <label for="ContactFormMessage" class="form-label">
                Message *
              </label>
              <textarea
                name="contact[body]"
                id="ContactFormMessage"
                rows="5"
                required
                placeholder="Describe your inquiry in detail..."
                class="form-input"
                style="resize: vertical;"
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </div>

            <button
              type="submit"
              class="btn-tech-primary"
              style="width: 100%; margin-top: 1.25rem; padding: 0.875rem 1rem; font-size: 0.75rem; letter-spacing: 0.08em; display: flex; align-items: center; justify-content: center; gap: 0.5rem;"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <span>TRANSMIT INQUIRY</span>
            </button>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 5fr 7fr;
      gap: 2.5rem;
    }
  }
  .contact-card {
    padding: 1.5rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .contact-card:hover {
    border-color: var(--border-bright);
    transform: translateY(-2px);
  }
  .contact-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-tech);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--success-color);
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .contact-whatsapp-btn:hover {
    text-decoration: underline;
    opacity: 0.85;
  }
  .contact-social-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: var(--radius-xs);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .contact-social-link:hover {
    border-color: var(--text-primary);
    background-color: var(--bg-surface-elevated);
  }
  .contact-form-card {
    padding: 1.5rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
  }
  @media (min-width: 640px) {
    .contact-form-card {
      padding: 2rem;
    }
  }
  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form-label {
    display: block;
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.375rem;
    font-weight: 600;
  }
  .form-input {
    width: 100%;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-main);
    color: var(--text-primary);
    font-size: 0.875rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-xs);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form-input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 1px var(--accent-blue);
  }
  .contact-success-banner {
    padding: 3rem 1.5rem;
    text-align: center;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-main);
    border-radius: var(--radius-xs);
  }
  .contact-error-banner {
    padding: 0.875rem 1rem;
    margin-bottom: 1.25rem;
    background-color: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.3);
    color: #DC2626;
    border-radius: var(--radius-xs);
  }
  .dark .contact-error-banner {
    background-color: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #F87171;
  }
</style>

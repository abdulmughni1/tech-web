{% comment %}
  DEXYFIED About Block Snippet
  Shared between sections/main-about.liquid and fallback pages
{% endcomment %}

<div class="dexy-container" style="max-width: 56rem;">
  <!-- Brand Statement Banner -->
  <div class="about-hero-card reveal-on-scroll">
    <div class="about-hero-top">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style="background-color: #09090B; padding: 2px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center;">
          <img src="{{ 'dexyfied-logo-raw.jpg' | asset_url }}" alt="DEXYFIED" style="height: 2.25rem; width: auto; object-fit: contain; mix-blend-mode: screen; filter: contrast(1.25) brightness(1.1);">
        </div>
        <div style="display: flex; flex-direction: column; justify-content: center; line-height: 1;">
          <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-primary);">
            DEXYFIED
          </span>
          <span style="font-family: var(--font-tech); font-size: 0.625rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-dim); margin-top: 2px;">
            HARDWARE // PAKISTAN
          </span>
        </div>
      </div>
      <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;">
        EST. PAKISTAN // PHYSICAL TECH STORE
      </div>
    </div>

    <div style="padding-top: 2rem;">
      <span style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--accent-blue); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; font-weight: 700;">
        OUR FOUNDING PRINCIPLE
      </span>
      <h1 style="font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; text-transform: uppercase; color: var(--text-primary); line-height: 1.1; margin: 0 0 1rem 0;">
        Tech That Earns Its Place.
      </h1>
      <p style="font-family: var(--font-sans); font-size: 1rem; color: var(--text-muted); max-width: 42rem; line-height: 1.7; margin: 0;">
        DEXYFIED was founded on a straightforward principle: consumer technology should be practical, accessible, clearly priced, and dependable in daily use.
      </p>
    </div>
  </div>

  <!-- Core Pillars Grid -->
  <div style="margin-top: 2rem;" class="about-pillars-grid">
    <!-- Pillar 1 -->
    <div class="about-pillar-card reveal-on-scroll">
      <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700;">
        01 // VALUE
      </div>
      <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; text-transform: uppercase; color: var(--text-primary); margin: 0.5rem 0 0.5rem 0;">
        Accessible Pricing
      </h3>
      <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
        We select hardware that delivers core functional performance at direct, realistic prices without unnecessary brand markups.
      </p>
    </div>

    <!-- Pillar 2 -->
    <div class="about-pillar-card reveal-on-scroll">
      <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700;">
        02 // UTILITY
      </div>
      <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; text-transform: uppercase; color: var(--text-primary); margin: 0.5rem 0 0.5rem 0;">
        Everyday Practicality
      </h3>
      <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
        From ergonomic laptop stands to Bluetooth-calling smart watches and audio kits, our products are selected to serve real daily tasks.
      </p>
    </div>

    <!-- Pillar 3 -->
    <div class="about-pillar-card reveal-on-scroll">
      <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-primary); text-transform: uppercase; font-weight: 700;">
        03 // CLARITY
      </div>
      <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; text-transform: uppercase; color: var(--text-primary); margin: 0.5rem 0 0.5rem 0;">
        Clean Buying Experience
      </h3>
      <p style="font-family: var(--font-sans); font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6; margin: 0;">
        Clear technical data sheets, honest original-to-sale pricing, flat PKR 150 nationwide shipping, and Cash on Delivery across Pakistan.
      </p>
    </div>
  </div>

  <!-- Operating Philosophy -->
  <div class="about-philosophy-card reveal-on-scroll" style="margin-top: 2rem;">
    <h2 style="font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; text-transform: uppercase; color: var(--text-primary); margin: 0 0 1rem 0;">
      What We Stand For
    </h2>
    <div style="font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-muted); line-height: 1.7; display: flex; flex-direction: column; gap: 0.875rem;">
      <p style="margin: 0;">
        We do not believe in exaggerating specifications or using misleading marketing jargon. If a smartwatch has an IPS display with a YC1133 processor, we state those exact technical specifications directly so customers know precisely what hardware they are purchasing.
      </p>
      <p style="margin: 0;">
        Every order placed with DEXYFIED is treated with care. We verify details before shipping and provide direct, responsive support through our active phone line, email, and social channels.
      </p>
    </div>

    <div class="about-philosophy-footer">
      <div style="font-family: var(--font-tech); font-size: 0.6875rem; color: var(--text-dim); text-transform: uppercase; font-weight: 600;">
        HEADQUARTERS &amp; DISPATCH: PAKISTAN NATIONWIDE
      </div>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="btn-tech-primary"
        style="padding: 0.75rem 1.25rem; font-size: 0.75rem; letter-spacing: 0.08em; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;"
      >
        <span>EXPLORE PRODUCTS</span>
        <span>→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .about-hero-card {
    padding: 2rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface-subtle);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
  }
  @media (min-width: 640px) {
    .about-hero-card {
      padding: 3rem;
    }
  }
  .about-hero-top {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-main);
  }
  @media (min-width: 640px) {
    .about-hero-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .about-pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .about-pillars-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .about-pillar-card {
    padding: 1.5rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .about-pillar-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-bright);
  }
  .about-philosophy-card {
    padding: 2rem;
    border: 1px solid var(--border-main);
    background-color: var(--bg-surface);
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-2xs);
  }
  @media (min-width: 640px) {
    .about-philosophy-card {
      padding: 2.5rem;
    }
  }
  .about-philosophy-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-main);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .about-philosophy-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

{% comment %}
  DEXYFIED Technical Specifications Table Snippet
  High-contrast raw hardware data rows with optional data integrity notice
{% endcomment %}

<div class="tech-specs-table-wrapper" style="width: 100%;">
  <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-main); margin-bottom: 0.5rem;">
    <h3 style="font-family: var(--font-tech); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin: 0;">
      {{ title | default: 'TECHNICAL SPECIFICATIONS' }}
    </h3>
    <span style="font-family: var(--font-tech); font-size: 0.625rem; color: var(--text-dim); letter-spacing: 0.1em; text-transform: uppercase;">
      [RAW HARDWARE DATA]
    </span>
  </div>

  <div class="specs-table">
    {% if specifications != blank %}
      {{ specifications }}
    {% else %}
      {% comment %} Default Product Specifications parsed from description or standard format {% endcomment %}
      <div class="specs-row">
        <div class="specs-label">DEVICE COMPATIBILITY</div>
        <div class="specs-value">Universal Hardware Standard</div>
      </div>
      <div class="specs-row">
        <div class="specs-label">TESTING & QC</div>
        <div class="specs-value">100% Physical Bench-Tested Prior to Courier Dispatch</div>
      </div>
      <div class="specs-row">
        <div class="specs-label">LOGISTICS DISPATCH</div>
        <div class="specs-value">Flat PKR 150 Tracked Courier Nationwide Across Pakistan</div>
      </div>
      <div class="specs-row">
        <div class="specs-label">PAYMENT TERMS</div>
        <div class="specs-value">Cash on Delivery (COD) / Bank Transfer (Meezan / JazzCash)</div>
      </div>
      <div class="specs-row">
        <div class="specs-label">INSPECTION WINDOW</div>
        <div class="specs-value">7 Calendar Days Return Policy on Unused Items</div>
      </div>
    {% endif %}
  </div>

  {% if disclaimer != blank %}
    <div style="margin-top: 1rem; padding: 0.875rem; border: 1px solid var(--border-main); background-color: var(--bg-surface-elevated); color: var(--text-muted); font-size: 0.75rem; line-height: 1.5; font-family: var(--font-sans); border-radius: var(--radius-xs);">
      <span style="color: var(--accent-blue); font-family: var(--font-tech); font-size: 0.6875rem; font-weight: 700; margin-right: 0.375rem; text-transform: uppercase;">
        [DATA INTEGRITY NOTE]:
      </span>
      {{ disclaimer }}
    </div>
  {% endif %}
</div>

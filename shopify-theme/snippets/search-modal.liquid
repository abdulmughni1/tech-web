{% comment %}
  DEXYFIED Search Modal Snippet
{% endcomment %}

<style>
  [data-search-modal] {
    display: none !important;
  }
  [data-search-modal].open {
    display: flex !important;
  }
</style>

<div
  data-search-modal
  class="hidden"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  style="display: none !important; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 100; align-items: flex-start; justify-content: center; padding-top: 5rem; padding-left: 1rem; padding-right: 1rem;"
>
  <div style="background: var(--bg-surface); border: 1px solid var(--border-main); width: 100%; max-width: 36rem; border-radius: var(--radius-xs); box-shadow: var(--shadow-2xl); overflow: hidden;">
    <div style="display: flex; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border-main); gap: 0.75rem;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-dim); flex-shrink: 0;">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <form action="{{ routes.search_url }}" method="get" role="search" style="flex: 1; margin: 0;">
        <input
          type="search"
          name="q"
          placeholder="SEARCH HARDWARE CATALOG..."
          style="width: 100%; border: none; outline: none; background: transparent; font-family: var(--font-tech); font-size: 0.875rem; text-transform: uppercase; color: var(--text-primary);"
        >
      </form>
      <button
        type="button"
        data-search-close
        aria-label="Close search modal"
        style="padding: 0.25rem 0.5rem; border: 1px solid var(--border-main); border-radius: var(--radius-xs); font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); cursor: pointer;"
      >
        ESC
      </button>
    </div>
    <div style="padding: 1.25rem; font-family: var(--font-tech); font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase;">
      Press [Enter] to view matching hardware products in store
    </div>
  </div>
</div>
